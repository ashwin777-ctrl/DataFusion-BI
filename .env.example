# ── App Postgres (metadata only; never user row data) ───────────────────────
# The app connects as a NON-superuser role so RLS applies (PRD FR-1.6).
DATABASE_URL="postgres://bi_app:bi_app_pw@localhost:5433/bi_platform"
# Owner role for migrations (defaults to DATABASE_URL if unset).
MIGRATION_DATABASE_URL="postgres://bi_owner:bi_owner_pw@localhost:5433/bi_platform"

# ── Storage (persistent volume in prod) ──────────────────────────────────────
STORAGE_DIR="./storage"

# ── Secrets ───────────────────────────────────────────────────────────────────
# 32 bytes, base64:  openssl rand -base64 32
CREDENTIAL_ENC_KEY="REPLACE_ME_openssl_rand_base64_32"
# >=32 chars:        openssl rand -hex 32
AUTH_SECRET="REPLACE_ME_at_least_32_characters_long_secret"

# ── Upload limits (PRD FR-2.2) ────────────────────────────────────────────────
MAX_UPLOAD_BYTES=104857600
MAX_FILES_PER_BATCH=10

# ── Public origin ─────────────────────────────────────────────────────────────
APP_ORIGIN="http://localhost:3000"
