{
  "name": "bi-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:init": "node scripts/local-db.mjs init",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:status": "node scripts/local-db.mjs status",
    "db:bootstrap": "node scripts/bootstrap-db.mjs",
    "db:verify-rls": "node --env-file=.env scripts/verify-rls.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "seed:fixtures": "tsx --env-file=.env scripts/make-fixtures.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:ci": "playwright test --reporter=github"
  },
  "dependencies": {
    "@duckdb/node-api": "1.3.4-alpha.27",
    "@node-rs/argon2": "2.0.2",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.6",
    "@types/three": "^0.185.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "lucide-react": "0.469.0",
    "next": "15.5.23",
    "next-themes": "0.4.4",
    "pg": "8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "2.15.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "2.6.0",
    "three": "^0.185.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.23",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.23.12",
    "typescript": "5.7.2"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "sharp": "^0.35.0",
    "postcss": "$postcss"
  }
}
